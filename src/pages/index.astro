---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="TOW Blog — 여행 이야기">
  <div class="page-header">
    <h1>여행 이야기</h1>
    <p>패키지부터 자유여행까지, 솔직한 여행 후기를 담습니다.</p>
  </div>
  <ul class="post-list">
    {posts.map(post => (
      <li class="post-item">
        <a href={`/blog/${post.slug}`}>
          <h2 class="post-title">{post.data.title}</h2>
          <p class="post-desc">{post.data.description}</p>
          <div class="post-meta">
            <time>{post.data.pubDate.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
            {post.data.tags && post.data.tags.length > 0 && (
              <span class="post-tags">
                {post.data.tags.slice(0, 3).map(tag => <span class="tag">#{tag}</span>)}
              </span>
            )}
          </div>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 36px;
    padding-bottom: 24px;
    border-bottom: 2px solid #eee;
  }
  .page-header h1 {
    font-size: 24px;
    font-weight: 800;
    margin-bottom: 8px;
  }
  .page-header p {
    font-size: 15px;
    color: #888;
  }
  .post-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .post-item a {
    display: block;
    padding: 24px 0;
    border-bottom: 1px solid #eee;
    transition: opacity 0.15s;
  }
  .post-item a:hover { opacity: 0.7; }
  .post-title {
    font-size: 18px;
    font-weight: 700;
    color: #111;
    line-height: 1.5;
    margin-bottom: 8px;
    word-break: keep-all;
  }
  .post-desc {
    font-size: 14px;
    color: #666;
    line-height: 1.7;
    margin-bottom: 10px;
    word-break: keep-all;
  }
  .post-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  time {
    font-size: 13px;
    color: #aaa;
  }
  .post-tags { display: flex; gap: 6px; }
  .tag { font-size: 12px; color: #03c75a; }
</style>
